# =====================================================
# SISTEMA DE OFICIOS MUNICIPALES - Variables de entorno
# =====================================================
# Copia este archivo como .env.local y llena los valores
# desde tu proyecto en https://app.supabase.com

NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# URL de la aplicación (cambiar en producción)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nombre del ayuntamiento (aparece en reportes y login)
NEXT_PUBLIC_AYUNTAMIENTO_NOMBRE="H. Ayuntamiento Municipal"
NEXT_PUBLIC_AYUNTAMIENTO_MUNICIPIO="Tu Municipio, Estado"
